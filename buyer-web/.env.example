# Server the app talks to
VITE_API_BASE_URL=https://livecommerce-api-4s2b.onrender.com
# Paystack PUBLIC key (pk_test_... or pk_live_...). Never the secret key.
VITE_PAYSTACK_PUBLIC_KEY=

# staging | production. Staging shows a "STAGING · test money" badge.
VITE_APP_ENV=staging

# Optional: Places (New) address search; missing key keeps the area picker.
VITE_GOOGLE_MAPS_KEY=

# Leave unset for the plain State / Area / Street form. Only google enables Places.
VITE_ADDRESS_SEARCH=
