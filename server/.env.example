# Copy to .env for local development. Never commit real values.
# On the hosting platform, set these in its environment settings instead.

# --- Core (required in production) ---
NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/livecommerce
# Long random strings, e.g. from: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# --- Public URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Live video (Agora) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Show recording for auto-clips (Agora cloud recording, off unless all set) ---
# Customer ID and secret come from Agora console > RESTful API
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=eu-west-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# --- Payments and wallet (Paystack; use test keys until launch) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Delivery (Shipbubble; sandbox keys start with sb_sandbox) ---
SHIPBUBBLE_API_KEY=

# --- AI features (Google Gemini) ---
GEMINI_API_KEY=

# --- SMS and phone OTP (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Media storage (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
CDN_S3_BUCKET=
CDN_URL=

# --- Optional ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
