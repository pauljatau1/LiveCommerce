# Copy to .env for local development. Never commit real values.
# On the hosting platform, set these in its environment settings instead.

# --- Core (required in production) ---
NODE_ENV=development
# staging | production (shown at /health)
APP_ENV=staging
PORT=8000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/livecommerce
# Long random strings, e.g. from: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# --- Public URLs ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Sites allowed to call the API from a browser (comma-separated). Outside
# production, any http://localhost:<port> is also allowed.
ALLOWED_ORIGINS=

# Features outside the MVP are off. To switch any back on, list them here:
# blips,posts,messaging,coupons,flashSales,campaigns,referrals,returns,listings
EXTRA_FEATURES=

# --- Live video (Agora) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Show recording (Agora cloud recording; paid, off unless all set) ---
# Customer ID and secret come from Agora console > RESTful API
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=eu-west-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# --- Payments and wallet (Paystack; use test keys until launch) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Delivery (Shipbubble; sandbox keys start with sb_sandbox) ---
SHIPBUBBLE_API_KEY=
# Delivery deposit held at a buyer's first item in a show (naira)
DELIVERY_DEPOSIT_NGN=3000
# How long after delivery the seller's money is released (agenda syntax). Staging can use "in 2 minutes".
SELLER_RELEASE_DELAY=in 1 day
# Optional: force one Shipbubble package category id
SHIPBUBBLE_CATEGORY_ID=
# Optional: only quote these couriers (service codes), e.g. gigl,kwik
SHIPBUBBLE_COURIERS=
# Where fans open shows (share links)
BUYER_APP_URL=https://livecommerce-shop.onrender.com

# --- AI features (Google Gemini) ---
GEMINI_API_KEY=

# --- SMS and phone OTP (Termii; paid per message, off for the free pilot) ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Media storage: Cloudflare R2 (free tier) or AWS S3 ---
# For R2, set S3_ENDPOINT and leave AWS_REGION empty; for AWS S3, leave S3_ENDPOINT empty.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
CDN_S3_BUCKET=
# Public host of the bucket, without https:// (e.g. pub-xxxx.r2.dev)
CDN_URL=

# --- Admins ---
# Comma-separated emails allowed to register as an admin
ADMIN_EMAILS=
# Used once by `npm run seed` to create the first admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# --- Optional ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
