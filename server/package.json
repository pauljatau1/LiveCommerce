{
    "name": "auqli_server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "node server.js",
        "test": "jest --forceExit",
        "test:ci": "jest --forceExit --ci",
        "test:debug": "node --trace-warnings node_modules/.bin/jest --forceExit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --forceExit",
        "dev": "nodemon server.js",
        "migrate:up": "migrate-mongo up",
        "migrate:down": "migrate-mongo down",
        "migrate:create": "migrate-mongo create"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-sns": "^3.723.0",
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@sendgrid/mail": "^8.1.4",
        "agenda": "^5.0.0",
        "agora-access-token": "^2.0.4",
        "aws-sdk": "^2.1693.0",
        "bcrypt": "^5.1.1",
        "btoa": "^1.2.1",
        "canvas": "^3.1.0",
        "cloudinary": "^2.5.1",
        "compression": "^1.7.5",
        "cors": "^2.8.5",
        "country-state-city": "^3.2.1",
        "crypto": "^1.0.1",
        "csv-parser": "^3.2.0",
        "dotenv": "^16.4.5",
        "expo-server-sdk": "^3.14.0",
        "express": "^4.21.1",
        "express-rate-limit": "^7.5.0",
        "express-session": "^1.18.1",
        "firebase": "^11.3.1",
        "firebase-admin": "^13.1.0",
        "fluent-ffmpeg": "^2.1.3",
        "fuse.js": "^7.1.0",
        "google-auth-library": "^10.4.2",
        "jose": "^6.1.3",
        "json2csv": "^6.0.0-alpha.2",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^3.2.1",
        "jwt-decode": "^4.0.0",
        "memory-cache": "^0.2.0",
        "migrate-mongo": "^12.1.3",
        "mixpanel": "^0.18.1",
        "mongoose": "^8.8.0",
        "mongoose-autopopulate": "^1.1.0",
        "multer": "^1.4.5-lts.1",
