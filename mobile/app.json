{
  "expo": {
    "name": "auqli",
    "slug": "auqli-app",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/auqli-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auqli.auqliapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow access to your photos to upload images for your profile, reviews, and messages."
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": ["applinks:app.auqli.live"]
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.auqli.auqliapp",
      "runtimeVersion": "1.0.0",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appstore.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.auqli.live",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "permissions": ["INTERNET", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/auqli-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Your data will be used to deliver personalized ads to you."
        }
      ],
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "expo-tracking-transparency",

      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "847d35fd-12b4-42e3-a854-3065fe2e14cb"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "auqli_limited",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/847d35fd-12b4-42e3-a854-3065fe2e14cb"
    }
  }
}
