{
  "expo": {
    "name": "auqli",
    "slug": "auqli-app",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/auqli-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auqli.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false  
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.auqli.auqliapp",
      "runtimeVersion": "1.0.0",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/appstore.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": ["INTERNET"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/auqli-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111111"
        }
      ],
      "expo-dev-client",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "847d35fd-12b4-42e3-a854-3065fe2e14cb"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "auqli_limited",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/847d35fd-12b4-42e3-a854-3065fe2e14cb"
    }
  }
}
